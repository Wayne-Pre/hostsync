{
  "name": "hostsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HostSync rebuild — Stage 1 (one calendar that holds)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "node scripts/migrate.ts",
    "build:web": "node scripts/build-web.mjs",
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/selfcheck.mjs --tests-only",
    "selfcheck": "node scripts/selfcheck.mjs",
    "reconcile": "node scripts/reconcile.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1"
  }
}
